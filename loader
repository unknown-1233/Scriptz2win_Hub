local resultsSection
local resultsHolder = {}
local rebuildResults

local searchInput = SearchTab:CreateInput({
    Name = "Search games",
    Description = "Type to filter the list below",
    PlaceholderText = "Type a game name...",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        rebuildResults(text)
    end,
})

local function clearResults()
    if resultsSection then
        resultsSection:Destroy()
        resultsSection = nil
    end
    for _, item in ipairs(resultsHolder) do
        pcall(function() item:Destroy() end)
    end
    resultsHolder = {}
end

function rebuildResults(query)
    clearResults()
    query = (query or ""):lower()

    local matches = {}
    for _, entry in ipairs(sortedGames) do
        if query == "" or entry.name:lower():find(query, 1, true) then
            matches[#matches + 1] = entry
        end
    end

    resultsSection = SearchTab:CreateSection("Results (" .. #matches .. ")")

    for _, entry in ipairs(matches) do
        local entryRef = entry
        resultsHolder[#resultsHolder + 1] = SearchTab:CreateButton({
            Name = entry.name,
            Description = "Load script",
            Callback = function()
                execGameScript(entryRef)
            end,
        })
    end

    if #matches == 0 then
        resultsHolder[#resultsHolder + 1] = SearchTab:CreateLabel({ Text = "No games match '" .. query .. "'", Style = 3 })
    end
end

