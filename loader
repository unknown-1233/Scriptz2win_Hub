-- ===== LUNA GUI =====
local Luna = loadstring(game:HttpGet("https://raw.nebulasoftworks.xyz/luna", true))()

local Window = Luna:CreateWindow({
    Name = "Scriptz2Win",
    Subtitle = "Universal Script Loader",
    LoadingEnabled = true,
    LoadingTitle = "Scriptz2Win",
    LoadingSubtitle = "Universal Script Loader",
    ConfigSettings = { ConfigFolder = "Scriptz2Win" },
    KeySystem = false,
})

local function execGameScript(entry)
    local ok, err = pcall(function()
        loadstring(entry.script)()
    end)
    if not ok then
        Luna:Notification({ Title = "Scriptz2Win", Content = "Failed: " .. tostring(err), Icon = "error" })
    end
end

local function notify(title, content, icon)
    Luna:Notification({ Title = title, Content = content, Icon = icon or "info" })
end

local function sortGames()
    local list = {}
    local seen = {}
    for _, entry in pairs(ScriptDB) do
        table.insert(list, entry)
        seen[entry.name] = true
    end
    for _, entry in pairs(ScriptsByCreator) do
        if not seen[entry.name] then
            table.insert(list, entry)
        end
    end
    table.sort(list, function(a, b) return a.name < b.name end)
    return list
end

local sortedGames = sortGames()

-- ===== HOME TAB =====
local HomeTab = Window:CreateTab({ Name = "Home", Icon = "9080449299", ImageSource = "Custom", ShowTitle = true })
HomeTab:CreateSection("Current Game")

HomeTab:CreateLabel({ Text = currentGameName, Style = 2 })
HomeTab:CreateLabel({ Text = "Place ID: " .. tostring(placeId), Style = 1 })

local suggestion = ScriptDB[placeId] or ScriptByPlaceId[placeId] or ScriptsByCreator[game.CreatorId]
if suggestion then
    HomeTab:CreateSection("Script Found")
    HomeTab:CreateLabel({ Text = "A script is available for this game!", Style = 2 })
    HomeTab:CreateButton({ Name = "Load " .. suggestion.name, Description = "Execute the matching script", Callback = function()
        execGameScript(suggestion)
    end })
else
    HomeTab:CreateSection("No Script")
    HomeTab:CreateLabel({ Text = "No script found for this game.", Style = 3 })
    HomeTab:CreateLabel({ Text = "Use the Search tab to find one.", Style = 1 })
end

-- ===== SEARCH TAB =====
local SearchTab = Window:CreateTab({ Name = "Search", Icon = "6031154871", ImageSource = "Custom", ShowTitle = true })
SearchTab:CreateSection("Filter")

local resultsSection
local resultsHolder = {}
local rebuildResults

local searchInput = SearchTab:CreateInput({
    Name = "Search games",
    Description = "Type to filter the list below",
    PlaceholderText = "Type a game name...",
    RemoveTextAfterFocusLost = false,
    Callback = function(text)
        rebuildResults(text)
    end,
})

local function clearResults()
    if resultsSection then
        resultsSection:Destroy()
        resultsSection = nil
    end
    for _, item in ipairs(resultsHolder) do
        pcall(function() item:Destroy() end)
    end
    resultsHolder = {}
end

function rebuildResults(query)
    clearResults()
    query = (query or ""):lower()

    local matches = {}
    for _, entry in ipairs(sortedGames) do
        if query == "" or entry.name:lower():find(query, 1, true) then
            matches[#matches + 1] = entry
        end
    end

    resultsSection = SearchTab:CreateSection("Results (" .. #matches .. ")")

    for _, entry in ipairs(matches) do
        local entryRef = entry
        resultsHolder[#resultsHolder + 1] = SearchTab:CreateButton({
            Name = entry.name,
            Description = "Load script",
            Callback = function()
                execGameScript(entryRef)
            end,
        })
    end

    if #matches == 0 then
        resultsHolder[#resultsHolder + 1] = SearchTab:CreateLabel({ Text = "No games match '" .. query .. "'", Style = 3 })
    end
end

